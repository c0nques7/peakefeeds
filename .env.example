# Copy to .env.development.local for local development and tests (never commit real values).
# Production values live in Vercel: `vercel env ls production`.

# --- Database (Postgres) ---
# Local: `docker compose up -d postgres`, then `npx prisma migrate deploy`.
# Tests refuse to run unless this points at localhost.
DATABASE_URL="postgresql://peakeuser:peakepassword@localhost:5432/peakefeeds_local"
# Development only: "1" talks to Neon over WebSockets (port 443) when port 5432 is blocked
PRISMA_NEON_WS=

# --- Auth (next-auth) ---
NEXTAUTH_URL="http://localhost:3000"
# `openssl rand -base64 32`
NEXTAUTH_SECRET=
# Google sign-in is only offered when both are set
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (Resend): password resets; without it the reset link is printed in development ---
RESEND_API_KEY=

# --- Media storage (Backblaze B2, private bucket) ---
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_ID=
B2_BUCKET_NAME=
B2_ENDPOINT="s3.us-east-005.backblazeb2.com"

# --- Wallet connect (Reown/WalletConnect) ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
