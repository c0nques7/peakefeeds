// --------------------------------------
// 1. Configuration
// --------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------
// 2. Enums
// --------------------------------------

enum UserRole {
  STANDARD
  BUSINESS
  INFLUENCER
  FACT_CHECKER
  BOT
  GOVERNMENT
  MODERATOR
  ADMIN
}

enum ChannelRole {
  MEMBER
  MODERATOR
  OWNER
}

enum PostType {
  TEXT
  LONGFORM
  IMAGE
  VIDEO
  LINK
  QUOTE
  POLL
  REPOST
}

enum ReactionType {
  LIKE
  DISLIKE
}

enum ReportReason {
  SPAM
  HATE_SPEECH
  VIOLENCE
  MISINFORMATION
  COPYRIGHT_INFRINGEMENT
  IMPERSONATION
  TRADEMARK_VIOLATION
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ReportTargetType {
  POST
  USER
  CHANNEL
  MESSAGE
  COMMENT
  ADVERTISEMENT
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PenaltyType {
  WARNING
  STRIKE_1_TIMEOUT
  STRIKE_2_SUSPENSION
  PERMANENT_BAN
  CONTENT_REMOVAL
}

enum NotificationType {
  LIKE
  COMMENT
  REPLY
  MENTION
  SYSTEM
  TICKET_REPLY
  MESSAGE
  REPORT
  TICKET_UPDATE
}

// --------------------------------------
// 3. Core Application Models
// --------------------------------------

model User {
  id              String    @id @default(cuid())
  name            String?
  username        String?   @unique
  email           String?   @unique
  emailVerified   DateTime?
  image           String?
  passwordHash    String?
  walletAddress   String?   @unique
  role            UserRole  @default(STANDARD)
  strikeCount     Int       @default(0)
  isBanned        Boolean   @default(false)
  isLocked        Boolean   @default(false)
  mutedUntil      DateTime?
  managerId       String?
  manager         User?     @relation("BusinessManagement", fields: [managerId], references: [id])
  managedUsers    User[]    @relation("BusinessManagement")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  channelsCreated Channel[] @relation("CreatedChannels")
  posts           Post[]
  comments        Comment[]
  subscriptions   Subscription[]
  likes           Reaction[]

  reportsFiled    Report[]  @relation("ReportedBy")
  reportsResolved Report[]  @relation("ResolvedBy")
  reportsAgainst  Report[]  @relation("ProfileReported")
  
  penaltiesReceived Penalty[] @relation("ReceivedPenalties")
  penaltiesIssued   Penalty[] @relation("IssuedPenalties")
  adsWatched      AdView[]
  invitesIssued   InviteCode[] @relation("IssuedInvites")
  inviteUsed      InviteCode?  @relation("UsedInvite")
  supportTickets  SupportTicket[] @relation("UserTickets")
  assignedTickets SupportTicket[] @relation("AssignedTickets")
  notificationsReceived Notification[] @relation("NotificationsReceived")
  notificationsSent     Notification[] @relation("NotificationsTriggered")
  conversations   Conversation[] @relation("ConversationParticipants")
  messagesSent    DirectMessage[] @relation("SentMessages")
  blocksInitiated Block[] @relation("BlocksInitiated")
  blocksReceived  Block[] @relation("BlocksReceived")
  adminLogs       AdminLog[] @relation("AdminActions")
  ticketMessages  TicketMessage[] @relation("AdminMessages")
}

model Channel {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  description   String?
  tags          String[]
  isLocked      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  creatorId     String
  creator       User      @relation("CreatedChannels", fields: [creatorId], references: [id], onDelete: Cascade)
  subscribers   Subscription[]
  posts         Post[]
  reports       Report[]

  @@index([name])
}

model Subscription {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())
  role      ChannelRole @default(MEMBER)
  canPost        Boolean @default(true)
  canComment     Boolean @default(true)
  canDeletePosts Boolean @default(false)
  canPinPosts    Boolean @default(false)

  @@id([userId, channelId])
  @@index([userId])
}

model Post {
  id              String    @id @default(cuid())
  title           String?
  content         String    @db.Text
  type            PostType  @default(TEXT)
  mediaUrl        String?
  embedUrl        String?
  mediaHash       String?
  linkTitle       String?
  linkDescription String?   @db.Text
  linkImage       String?
  linkDomain      String?
  isVerified      Boolean   @default(false)
  isLocked        Boolean   @default(false)
  contentHash     String?
  salt            String?
  signature       String?
  verificationTx  String?
  verificationSource String?
  likesCount      Int       @default(0)
  dislikesCount   Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  channelId       String
  channel         Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId        String
  author          User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments        Comment[]
  likes           Reaction[]
  reports         Report[]
  notifications   Notification[]

  @@index([channelId, createdAt(sort: Desc)])
  @@index([authorId])
}

model Comment {
  id        String    @id @default(cuid())
  content   String    @db.Text
  isLocked  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  notifications Notification[]
  reports   Report[]

  @@index([postId])
  @@index([parentId])
}

model Reaction {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  type      ReactionType @default(LIKE)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

model Report {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  reason     ReportReason
  details    String?      @db.Text
  status     ReportStatus @default(PENDING)
  targetType ReportTargetType
  reporterId String
  reporter   User     @relation("ReportedBy", fields: [reporterId], references: [id])
  postId     String?
  post       Post?     @relation(fields: [postId], references: [id], onDelete: SetNull)
  reportedProfileId String?
  reportedProfile   User?     @relation("ProfileReported", fields: [reportedProfileId], references: [id])
  channelId  String?
  channel    Channel? @relation(fields: [channelId], references: [id])
  messageId  String?
  message    DirectMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  commentId  String?
  comment    Comment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
  adId       String?
  resolverId String?
  resolver   User?  @relation("ResolvedBy", fields: [resolverId], references: [id])
  penalty    Penalty?
  notifications Notification[]

  @@index([status])
  @@index([reporterId])
}

model Penalty {
  id            String      @id @default(cuid())
  createdAt     DateTime    @default(now())
  type          PenaltyType
  reason        String      @db.Text
  expiresAt     DateTime?
  isActive      Boolean     @default(true)
  userId        String
  user          User        @relation("ReceivedPenalties", fields: [userId], references: [id])
  issuerId      String
  issuer        User        @relation("IssuedPenalties", fields: [issuerId], references: [id])
  reportId      String?     @unique
  report        Report?     @relation(fields: [reportId], references: [id])

  @@index([userId])
}

model AdView {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  provider  String
  txHash     String?
  revenueEst Float?
  userId     String
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

enum WaitlistStatus {
  PENDING
  INVITED
  REGISTERED
}

model Waitlist {
  id        String          @id @default(cuid())
  email     String          @unique
  joinedAt  DateTime        @default(now())
  status    WaitlistStatus @default(PENDING)
  source    String?
  medium    String?
  campaign  String?
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model InviteCode {
  id        String   @id @default(cuid())
  code      String   @unique
  createdAt DateTime @default(now())
  usedAt    DateTime?
  issuerId  String?
  issuer    User?     @relation("IssuedInvites", fields: [issuerId], references: [id])
  usedById  String?   @unique
  usedBy    User?     @relation("UsedInvite", fields: [usedById], references: [id])
}

model SupportTicket {
  id              String   @id @default(cuid())
  status          SupportStatus @default(OPEN)
  priority        SupportPriority @default(LOW)
  severity        Int      @default(0)
  internalNotes   String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  userId          String?
  user            User?    @relation("UserTickets", fields: [userId], references: [id])
  assigneeId      String?
  assignee        User?    @relation("AssignedTickets", fields: [assigneeId], references: [id])
  messages        TicketMessage[]
  directMessages  DirectMessage[]
  notifications   Notification[]

  @@index([status])
  @@index([userId])
  @@index([assigneeId])
}


model TicketMessage {
  id              String        @id @default(cuid())
  text            String        @db.Text
  sender          String        // "user", "admin", "bot"
  createdAt       DateTime      @default(now())
  ticketId        String
  ticket          SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  adminId         String?
  admin           User?         @relation("AdminMessages", fields: [adminId], references: [id])
  isInternal      Boolean       @default(false)

  @@index([ticketId])
  @@index([adminId])
}

model Notification {
  id        String           @id @default(cuid())
  createdAt DateTime         @default(now())
  isRead    Boolean          @default(false)
  type      NotificationType
  userId    String
  user      User             @relation("NotificationsReceived", fields: [userId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?            @relation("NotificationsTriggered", fields: [actorId], references: [id], onDelete: Cascade)
  postId    String?
  post      Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId String?
  comment   Comment?         @relation(fields: [commentId], references: [id], onDelete: Cascade)
  ticketId  String?
  ticket    SupportTicket?   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  reportId  String?
  report    Report?          @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@index([reportId])
}

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  participants User[] @relation("ConversationParticipants")
  messages     DirectMessage[]
  lastMessageAt DateTime @default(now())

  @@index([lastMessageAt])
}

model DirectMessage {
  id        String   @id @default(cuid())
  content   String   @db.Text
  createdAt DateTime @default(now())
  senderId  String
  sender    User   @relation("SentMessages", fields: [senderId], references: [id])
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  ticketId       String?
  ticket         SupportTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  isRead    Boolean @default(false)
  reports   Report[]

  @@index([conversationId])
}

model Block {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  blockerId String
  blocker   User     @relation("BlocksInitiated", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
}

enum AdminLogType {
  AUTH_LOGIN
  AUTH_LOGOUT
  USER_UPDATE
  USER_DELETE
  CONTENT_LOCK
  CONTENT_UNLOCK
  REPORT_RESOLVE
  CONFIG_CHANGE
  ADMIN_ACTION
  SUPPORT_TICKET
}

model AdminLog {
  id             String       @id @default(cuid())
  createdAt      DateTime     @default(now())
  adminId        String
  admin          User         @relation("AdminActions", fields: [adminId], references: [id])
  eventType      AdminLogType
  targetResource String?
  details        Json?
  ipAddress      String?
  userAgent      String?

  @@index([adminId])
  @@index([eventType])
  @@index([createdAt])
}
