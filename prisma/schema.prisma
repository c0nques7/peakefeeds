// --------------------------------------
// 1. Configuration
// --------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------
// 2. Enums
// --------------------------------------

// GLOBAL USER ROLES
enum UserRole {
  STANDARD      // Default user: Post, Comment, Like
  
  // Commercial & Creators
  BUSINESS      // Corporate entities: Ads, Analytics, Manager of Influencers
  INFLUENCER    // Paid creators: Managed by Business, Wallet Payouts
  
  // Trust & Transparency (The Truth Layer)
  FACT_CHECKER  // Independent auditors: Can attach context/notes to posts
  BOT           // Automated/API accounts: Must be clearly labeled
  GOVERNMENT    // Official public sector: High-tier verification for alerts
  
  // Platform Management
  MODERATOR     // Global moderation: Can delete/hide content platform-wide
  ADMIN         // Superuser: Full system access
}

// CHANNEL-SPECIFIC PERMISSIONS
enum ChannelRole {
  MEMBER        // Standard subscriber
  MODERATOR     // Can delete/pin posts in this specific channel
  OWNER         // Creator: Can edit settings, ban users from channel
}

// POST TYPES
enum PostType {
  TEXT
  LONGFORM
  IMAGE
  VIDEO
  LINK
  QUOTE
  POLL
  REPOST
}

enum ReactionType {
  LIKE
  DISLIKE
}

// 🛡️ MODERATION & REPORTING ENUMS
enum ReportReason {
  SPAM
  HATE_SPEECH
  VIOLENCE
  MISINFORMATION          // Fact check related
  COPYRIGHT_INFRINGEMENT  // Ownership violation
  IMPERSONATION           // Identity fraud (User)
  TRADEMARK_VIOLATION     // Brand fraud (Channel)
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ReportTargetType {
  POST
  USER
  CHANNEL
}

enum PenaltyType {
  WARNING                 // Just a notification
  STRIKE_1_TIMEOUT        // 24hr mute
  STRIKE_2_SUSPENSION     // 7-day ban
  PERMANENT_BAN           // Account locked
  CONTENT_REMOVAL         // Content gone, no strike
}

// 🔔 NEW: Notification Types
enum NotificationType {
  LIKE
  COMMENT
  REPLY
  MENTION
  SYSTEM
  TICKET_REPLY
  MESSAGE
}

// --------------------------------------
// 3. Core Application Models
// --------------------------------------

model User {
  id              String    @id @default(cuid())
  name            String?
  username        String?   @unique
  email           String?   @unique
  emailVerified   DateTime?
  image           String?
  passwordHash    String?
  
  // 🛡️ Web3 Identity
  walletAddress   String?   @unique

  // GLOBAL ROLE
  role            UserRole  @default(STANDARD)

  // 🛡️ SAFETY & STANDING (The Justice System)
  strikeCount     Int       @default(0)
  isBanned        Boolean   @default(false)
  mutedUntil      DateTime? // If set, user cannot post/comment

  // BUSINESS MANAGEMENT
  managerId       String?
  manager         User?     @relation("BusinessManagement", fields: [managerId], references: [id])
  managedUsers    User[]    @relation("BusinessManagement")
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // --- Relations ---
  accounts        Account[]
  sessions        Session[]

  // Content Creation
  channelsCreated Channel[]        @relation("CreatedChannels")
  posts           Post[]
  comments        Comment[]
  
  // Engagement
  subscriptions   Subscription[]
  likes           Reaction[] 

  // Moderation Relations
  reportsFiled    Report[]  @relation("ReportedBy")
  reportsResolved Report[]  @relation("ResolvedBy")
  reportsAgainst  Report[]  @relation("ProfileReported") // Reports filed against this user
  
  penaltiesReceived Penalty[] @relation("ReceivedPenalties")
  penaltiesIssued   Penalty[] @relation("IssuedPenalties")
  
  // Monetization
  adsWatched      AdView[]

  // 🚀 GROWTH ENGINE
  invitesIssued   InviteCode[] @relation("IssuedInvites")
  inviteUsed      InviteCode?  @relation("UsedInvite")

  // 🆘 SUPPORT SYSTEM
  supportTickets  SupportTicket[]

  // 🔔 NOTIFICATIONS
  notificationsReceived Notification[] @relation("NotificationsReceived")
  notificationsSent     Notification[] @relation("NotificationsTriggered")

  // 💬 MESSAGING
  conversations Conversation[] @relation("ConversationParticipants")
  messagesSent  DirectMessage[] @relation("SentMessages")
}

model Channel {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  description   String?
  tags          String[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // --- Relations ---
  creatorId     String
  creator       User             @relation("CreatedChannels", fields: [creatorId], references: [id], onDelete: Cascade)
  
  subscribers   Subscription[]
  posts         Post[]
  reports       Report[] // Reports filed against this channel

  @@index([name])
}

model Subscription {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  joinedAt  DateTime @default(now())
  role      ChannelRole @default(MEMBER)

  @@id([userId, channelId])
  @@index([userId])
}

// --------------------------------------
// 4. Post and Media Models
// --------------------------------------

model Post {
  id              String    @id @default(cuid())
  title           String?
  content         String    @db.Text
  
  // Media Handling
  type            PostType  @default(TEXT)
  mediaUrl        String?
  embedUrl        String?   
  mediaHash       String?

  // Link Metadata
  linkTitle       String?
  linkDescription String?   @db.Text
  linkImage       String?
  linkDomain      String?   // e.g. "nytimes.com"
  
  // 🛡️ THE TRUTH LAYER (Verification)
  isVerified           Boolean   @default(false)
  
  // 1. The Data Integrity
  contentHash          String?   // SHA256(Content + Salt)
  salt                 String?   // Random pepper for GDPR compliance
  signature            String?   // User's cryptographic signature
  
  // 2. The Blockchain Anchor
  verificationTx       String?   // The Optimism Transaction Hash (0x...)
  verificationSource   String?   // "WALLET" | "HYPELAB" | "GOOGLE" (Who paid gas?)

  // Post Reactions (Cached Counts)
  likesCount       Int       @default(0)
  dislikesCount    Int       @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId  String
  author    User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[]
  likes     Reaction[] 
  
  // Safety
  reports   Report[]
  
  // 🔔 Notifications linked to this post
  notifications Notification[]

  @@index([channelId, createdAt(sort: Desc)])
  @@index([authorId])
}

// --------------------------------------
// 5. Engagement Models
// --------------------------------------

model Comment {
  id        String    @id @default(cuid())
  content   String    @db.Text
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Author
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Parent Post
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  // Threading
  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")

  // 🔔 Notifications linked to this comment
  notifications Notification[]

  @@index([postId])
  @@index([parentId])
}

model Reaction { 
  id        String    @id @default(cuid())
  createdAt DateTime @default(now())

  type      ReactionType @default(LIKE) 
  
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  @@unique([userId, postId])
  @@index([postId])
}

// --------------------------------------
// 6. Safety & Moderation (The Justice System)
// --------------------------------------

model Report {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  
  reason     ReportReason
  details    String?      @db.Text
  status     ReportStatus @default(PENDING)
  targetType ReportTargetType

  // The Reporter
  reporterId String
  reporter   User     @relation("ReportedBy", fields: [reporterId], references: [id])
  
  // Sparse Fields
  postId       String?
  post         Post?     @relation(fields: [postId], references: [id], onDelete: SetNull)

  reportedProfileId String?
  reportedProfile   User?     @relation("ProfileReported", fields: [reportedProfileId], references: [id])

  channelId    String?
  channel      Channel? @relation(fields: [channelId], references: [id])

  // Resolution
  resolverId String?
  resolver   User?  @relation("ResolvedBy", fields: [resolverId], references: [id])
  
  // Penalty
  penalty    Penalty?

  @@index([status])
  @@index([reporterId])
}

model Penalty {
  id            String      @id @default(cuid())
  createdAt     DateTime    @default(now())
  
  type          PenaltyType
  reason        String      @db.Text 
  
  expiresAt     DateTime?   // Null = Permanent
  isActive      Boolean     @default(true)

  // Relations
  userId        String      // The offender
  user          User        @relation("ReceivedPenalties", fields: [userId], references: [id])
  
  issuerId      String      // The Moderator
  issuer        User        @relation("IssuedPenalties", fields: [issuerId], references: [id])
  
  reportId      String?     @unique
  report        Report?     @relation(fields: [reportId], references: [id])

  @@index([userId])
}

// --------------------------------------
// 7. Ad Framework
// --------------------------------------

model AdView {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  provider  String   // "HYPELAB", "GOOGLE", "UNITY"
  
  // Monetization Data
  txHash     String? // If we sponsored gas, track it here
  revenueEst Float?  // Estimated earning from this view (USD)

  userId     String
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

// --------------------------------------
// 8. Marketing & Waitlist
// --------------------------------------

enum WaitlistStatus {
  PENDING
  INVITED
  REGISTERED
}

model Waitlist {
  id        String         @id @default(cuid())
  email     String         @unique
  joinedAt  DateTime       @default(now())
  
  status    WaitlistStatus @default(PENDING)
  
  // Marketing Attribution
  source    String?    
  medium    String?    
  campaign  String?    
}

// --------------------------------------
// 9. NextAuth Boilerplate
// --------------------------------------

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --------------------------------------
// 10. The Invite System
// --------------------------------------

model InviteCode {
  id        String   @id @default(cuid())
  code      String   @unique
  createdAt DateTime @default(now())

  usedAt    DateTime? 
  
  issuerId  String?  
  issuer    User?     @relation("IssuedInvites", fields: [issuerId], references: [id])

  usedById  String?   @unique
  usedBy    User?     @relation("UsedInvite", fields: [usedById], references: [id])
}

// --------------------------------------
// 11. Support System
// --------------------------------------

model SupportTicket {
  id              String   @id @default(cuid())
  status          String   @default("open") // "open", "resolved", "closed"
  
  // PRIORITY SCALE (0-5)
  severity        Int      @default(0) 

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Link to a registered user
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  
  // The conversation history
  messages        TicketMessage[]
  
  // 🔔 Notifications linked to this ticket
  notifications Notification[]

  @@index([status])
  @@index([userId])
}

model TicketMessage {
  id              String        @id @default(cuid())
  text            String        @db.Text
  sender          String        // "user", "admin", "bot"
  createdAt       DateTime      @default(now())
  
  // Relationship to the ticket
  ticketId        String
  ticket          SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  // Optional: If you want to know WHICH admin replied
  adminId         String?       
  
  @@index([ticketId])
}

// --------------------------------------
// 12. Notification System (NEW)
// --------------------------------------

model Notification {
  id        String           @id @default(cuid())
  createdAt DateTime         @default(now())
  isRead    Boolean          @default(false)
  type      NotificationType

  // 1. The Recipient (Who sees the red dot?)
  userId    String
  user      User             @relation("NotificationsReceived", fields: [userId], references: [id], onDelete: Cascade)

  // 2. The Trigger (Who did it?) - Optional for System messages
  actorId   String?
  actor     User?            @relation("NotificationsTriggered", fields: [actorId], references: [id], onDelete: Cascade)

  // 3. The Context (Polymorphic Links - only one usually populated)
  postId    String?
  post      Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)

  commentId String?
  comment   Comment?         @relation(fields: [commentId], references: [id], onDelete: Cascade)

  ticketId  String?
  ticket    SupportTicket?   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // 4. Performance: Indexing for the "Show my unread" query
  @@index([userId, isRead]) 
  @@index([createdAt])
}

// --------------------------------------
// 13. User Messaging (DMs)
// --------------------------------------

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The participants (Usually 2 for DMs, but allows groups later)
  participants User[] @relation("ConversationParticipants")

  // The messages in this chat
  messages     DirectMessage[]

  // For sorting inbox by most recent activity
  lastMessageAt DateTime @default(now())

  @@index([lastMessageAt])
}

model DirectMessage {
  id        String   @id @default(cuid())
  content   String   @db.Text
  createdAt DateTime @default(now())

  // Who sent it?
  senderId  String
  sender    User   @relation("SentMessages", fields: [senderId], references: [id])

  // Where does it belong?
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Read Status (Simplest version: If created > user's last view)
  // We can add a specialized "ReadReceipt" model later if needed
  isRead    Boolean @default(false)

  @@index([conversationId])
}